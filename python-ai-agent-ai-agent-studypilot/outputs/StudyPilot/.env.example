# Reference only: StudyPilot does not automatically load .env files.
# Set these variables in your server process or hosting platform. Never commit values.
# Optional AI: fixed GLM-4.7-Flash primary and Xing4.0-29B fallback in studypilot/ai.py.
# No implicit paid-model substitution. Availability and pricing follow provider policies.
ZHIPU_API_KEY=
SILICONFLOW_API_KEY=
# Optional: set to 0 to pause model calls. Core learning management still works.
# STUDYPILOT_AI_ENABLED=1
# Optional persistent quotas: 15 requests per account per 600 seconds; 400/day UTC site-wide.
# STUDYPILOT_AI_USER_LIMIT=15
# STUDYPILOT_AI_WINDOW_SECONDS=600
# STUDYPILOT_AI_SITE_LIMIT=400
# Required for deployed Web: PostgreSQL URL (POSTGRES_URL is an alternative).
# Not required in explicit local SQLite mode. Never use production data for tests.
DATABASE_URL=
# POSTGRES_URL=
# Required for local Web SQLite mode only (ignored on Vercel):
# STUDYPILOT_WEB_LOCAL=1
# Optional local account-data directory; defaults to data/accounts in the application.
# STUDYPILOT_AUTH_DIR=
# Optional Streamlit legacy import source only:
# STUDYPILOT_DB=
# Tests only: an independent localhost PostgreSQL database, never production.
# STUDYPILOT_TEST_POSTGRES=
# Developer roles are managed by trusted administration tools, not registration or env vars.
